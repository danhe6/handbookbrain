OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LiteLLM model strings (provider/model)
HB_MODEL=anthropic/claude-sonnet-5-5
# cheap dev iterations: HB_MODEL=openai/gpt-4.1-mini ; switch back for reported numbers / demo
# HB_CACHE=1 caches identical LLM requests on disk (.cache/llm); set 0 for the final benchmark run
HB_CACHE=1
# dev mode: answer only this share of questions found in chat/tickets during replay (1 = all)
HB_ANSWER_SAMPLE=1
HB_CRITIC_MODEL=openai/gpt-4o-mini
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
HB_GRAPH=handbookbrain
# T0 = the date the graph is first built at; replay then walks real commits forward
HB_T0=2026-04-01
